# --- Database ---
# Local: postgres://user:pass@localhost:5432/locker
# Managed (Neon/Supabase): use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locker?schema=public"
# Direct (non-pooled) connection, used by Prisma for migrations / db push.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/locker?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Canonical base URL Auth.js uses to build callback URLs.
AUTH_URL="http://localhost:3000"

# --- Resend (transactional email: verification codes, password resets) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"
# Must be an address on a domain you've verified in Resend. The shared
# "onboarding@resend.dev" sender works with zero setup but can only deliver
# to your own Resend account email — fine for local dev, not for real users.
RESEND_FROM_EMAIL="Locker <onboarding@resend.dev>"

# Public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase Storage (file uploads: achievement certificates/photos,
# group and class resources) — a separate quota from the Postgres
# database's own 500MB limit, so file bytes never compete with row
# storage. Postgres only ever stores the resulting public URL.
#
# Setup (one-time, in the Supabase dashboard — same project as your DATABASE_URL):
#   1. Storage → New bucket. Name it whatever you like (e.g. "locker-uploads")
#      and mark it Public (certificates/photos are meant to be viewable).
#   2. Settings → API — copy the Project URL and the "anon public" key.
#   3. Settings → API → copy the "service_role" key too (server-only,
#      NEVER exposed to the browser — this is what lets the server hand
#      out signed upload URLs on the app's own auth checks).
NEXT_PUBLIC_SUPABASE_URL="https://replace-me.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_STORAGE_BUCKET="locker-uploads"

# --- School paywall bypass ---
# createSchool (SCHOOL only) requires this code alongside the $85/mo
# pricing shown on the paywall — see core/school/actions.ts. Nobody gets
# past it without knowing this value; rotate it any time by changing this
# and telling whoever's supposed to have it.
SCHOOL_CREATION_DEV_CODE="replace-me"
