# --- Database ---
# Local: postgres://user:pass@localhost:5432/locker
# Managed (Neon/Supabase): use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locker?schema=public"
# Direct (non-pooled) connection, used by Prisma for migrations / db push.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/locker?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Canonical base URL Auth.js uses to build callback URLs.
AUTH_URL="http://localhost:3000"

# --- Resend (transactional email: verification codes, password resets) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"
# Must be an address on a domain you've verified in Resend. The shared
# "onboarding@resend.dev" sender works with zero setup but can only deliver
# to your own Resend account email — fine for local dev, not for real users.
RESEND_FROM_EMAIL="Locker <onboarding@resend.dev>"

# Public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudflare R2 (file uploads: achievement certificates/photos, group
# and class resources) — S3-compatible object storage, kept separate from
# the Postgres database so file bytes never compete with the DB's own
# storage quota. Postgres only ever stores the resulting public URL.
#
# Setup (one-time, in the Cloudflare dashboard):
#   1. R2 → Create bucket. Name it whatever you like (e.g. "locker-uploads").
#   2. That bucket → Settings → enable public access, note the public URL
#      it gives you (a *.r2.dev URL, or your own custom domain).
#   3. R2 → Manage API tokens → create a token with read+write access
#      scoped to that bucket. Copy the Account ID, Access Key ID, and
#      Secret Access Key it gives you — the secret is shown once.
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="locker-uploads"
R2_PUBLIC_URL="https://replace-me.r2.dev"
